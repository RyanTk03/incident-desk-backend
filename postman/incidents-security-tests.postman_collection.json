                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Email suspect\",\n  \"description\": \"Lien de phishing recu\",\n  \"category\": \"PHISHING\",\n  \"priority\": \"HIGH\"\n}"
